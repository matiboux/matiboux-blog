---
import Default from '~/layouts/Default.astro'
import type { Props as DefaultProps } from '~/layouts/Default.astro'

export interface Props extends DefaultProps
{
	title: string
	date: Date
	last_updated?: Date | undefined
	categories?: string[] | undefined
	tags?: string[] | undefined
}

const { title, date, last_updated, categories, tags, ...defaultProps } = Astro.props

const dateFormatter = new Intl.DateTimeFormat(
	Astro.currentLocale === 'fr' ? 'fr-FR' : 'en-US',
	{ year: 'numeric', month: 'long', day: 'numeric' },
)
---

<Default {...defaultProps} title={title}>

	<div class="post">
		<h1 class="title">{title}</h1>

		<p class="metadata date">
			<span class="icon icon-[mdi--calendar] icon-align icon-fw"></span>
			{dateFormatter.format(date)}
		</p>
		{last_updated && (
			<p class="metadata last-updated">
				<span class="icon icon-[mdi--pencil] icon-align icon-fw"></span>
				{dateFormatter.format(last_updated)}
			</p>
		)}
		{categories && categories.length > 0 && (
			<p class="metadata categories">
				<span class="icon icon-[mdi--format-quote-open] icon-align icon-fw"></span>
				{categories.map((category) => <span>{category}</span>)}
			</p>
		)}
		{tags && tags.length > 0 && (
			<p class="metadata tags">
				<span class="icon icon-[mdi--tag] icon-align icon-fw"></span>
				{tags.map((tag) => <span>{tag}</span>)}
			</p>
		)}

		<div class="content">
			<slot />
		</div>
	</div>

</Default>
